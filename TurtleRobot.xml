<mujoco model="paddle_turtle_body">
    
    <compiler angle="degree" coordinate="local" />
    <option timestep="0.002" gravity="0 0 -9.81" iterations="50" integrator="RK4" />

    <default>
        <geom condim="3" conaffinity="0" density="400" friction="1 0.5 0.5" margin="0.01" rgba="0.3 0.6 0.3 1" />
        <joint armature="1e-5" damping="1" limited="true" />
    </default>

    <worldbody>
        <body name="turtle" pos="0 0 0.08">
            <joint name="root_free" type="free" />

            
            <geom name="shell" type="capsule" fromto="-0.20 0 0.08  0.20 0 0.08" size="0.12" rgba="0.2 0.5 0.2 1" />

            
            <body name="flipper_L_upper" pos="0.10 0.15 0.08">
                <joint name="shoulder_L" type="hinge" axis="0 -1 0" range="-60 60" />
                <geom name="flipper_L_upper_geom" type="capsule" fromto="0 0 0  0.068 0 0" size="0.04" rgba="0.2 0.4 0.7 1" />

                
                <body name="flipper_L_fore" pos="0.068 0 0">
                    <joint name="elbow_L" type="hinge" axis="0 -1 0" range="-90 0" />
                    <geom name="flipper_L_fore_geom" type="capsule" fromto="0 0 0  0.184 0 0" size="0.035" rgba="0.2 0.4 0.8 1" />
                </body>
            </body>

            
            <body name="flipper_R_upper" pos="0.10 -0.15 0.08">
                <joint name="shoulder_R" type="hinge" axis="0 1 0" range="-60 60" />
                <geom name="flipper_R_upper_geom" type="capsule" fromto="0 0 0  0.160 0 0" size="0.04" rgba="0.2 0.4 0.7 1" />

                
                <body name="flipper_R_fore" pos="0.160 0 0">
                    <joint name="elbow_R" type="hinge" axis="0 1 0" range="-90 0" />
                    <geom name="flipper_R_fore_geom" type="capsule" fromto="0 0 0  0.229 0 0" size="0.035" rgba="0.2 0.4 0.8 1" />
                </body>
            </body>

            
            <site name="shell_center" pos="0 0 0.08" size="0.01" />
        </body>

        <camera name="follow" mode="trackcom" pos="0 -2 0.5" xyaxes="1 0 0 0 0 1" />
    </worldbody>

    <actuator>
        <motor name="motor_shoulder_L" joint="shoulder_L" gear="100" ctrlrange="-1 1" ctrllimited="true" />
        <motor name="motor_elbow_L" joint="elbow_L" gear="100" ctrlrange="-1 1" ctrllimited="true" />

        <motor name="motor_shoulder_R" joint="shoulder_R" gear="100" ctrlrange="-1 1" ctrllimited="true" />
        <motor name="motor_elbow_R" joint="elbow_R" gear="100" ctrlrange="-1 1" ctrllimited="true" />
    </actuator>

    <sensor>
        <accelerometer site="shell_center" />
        <gyro site="shell_center" />
    </sensor>
</mujoco>